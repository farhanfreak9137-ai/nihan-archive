{
  "name": "nila-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:data": "tsx scripts/build-archive.ts && tsx scripts/build-intimate-vault.ts",
    "verify:data": "tsx scripts/verify-data.ts",
    "cap:sync": "npx cap sync android",
    "build:apk": "npm run build && npx cap sync android && powershell -Command \"$env:JAVA_HOME = 'C:\\Users\\RCP\\.jdk21\\jdk-21.0.6+7'; $env:ANDROID_HOME = 'C:\\Users\\RCP\\AppData\\Local\\Android\\Sdk'; cd android; .\\gradlew assembleDebug; Copy-Item app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\NilaArchive.apk -Force\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@tanstack/react-virtual": "^3.13.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
